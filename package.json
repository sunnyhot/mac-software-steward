{
  "name": "mac-software-steward",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Local macOS software scanner and updater for Applications, Homebrew, and Mac App Store packages.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:native": "bash scripts/build-native.sh",
    "package:release": "bash scripts/package-release.sh",
    "release:github": "bash scripts/release-github.sh",
    "open:native": "bash scripts/build-native.sh && open build/MacSoftwareSteward.app",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
